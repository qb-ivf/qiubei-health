# 复制为 .env 后按需修改（.env 不入库）
APP_NAME=Qiubei SaaS Backend
DEBUG=true
# API 宿主机监听地址：默认仅本机；本地真机通过局域网联调时可临时改 0.0.0.0，生产禁止。
API_BIND_HOST=127.0.0.1

# 数据库（以下是本地开发默认值；生产首次初始化前必须替换口令）
# 已有 MySQL 数据卷不能只改这里，须按 deploy/ops-cheatsheet.md 1.3 同步 ALTER USER。
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=qiubei
MYSQL_USER=qiubei
MYSQL_PASSWORD=qiubei
DATABASE_URL=mysql+aiomysql://qiubei:qiubei@localhost:3306/qiubei?charset=utf8mb4

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT（生产务必替换强密钥）
JWT_SECRET=CHANGE_ME_IN_PROD
JWT_EXPIRE_MINUTES=1440

# 敏感字段加密 Fernet key（生成：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"）
ENCRYPTION_KEY=

# 微信登录（小程序 AppID/Secret；留空仅 DEBUG=true 可走开发 mock，生产直接拒绝）
WX_PATIENT_APPID=
WX_PATIENT_SECRET=
WX_DOCTOR_APPID=
WX_DOCTOR_SECRET=

# 腾讯云短信（生产必须完整配置；留空仅 DEBUG=true 返回开发验证码）
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou

# 医生白名单：开发 true（自动通过），生产 false（走 admin 终审）
DOCTOR_AUTO_APPROVE=true

# CORS 白名单（生产填 admin-web 域名，逗号分隔；空=不允许跨域。小程序不受影响）
CORS_ORIGINS=

# 腾讯云 TRTC（密钥仅存服务端）
TRTC_SDKAPPID=0
TRTC_SECRETKEY=

# 微信支付（商户主体：天津逑贝互联网医院有限公司）
WX_APPID=                    # 发起支付的小程序 AppID（患者端）
WX_MCHID=                    # 商户号
WX_API_V3_KEY=              # APIv3 密钥（32 位）
WX_MCH_CERT_SERIAL=         # 商户 API 证书序列号
WX_MCH_PRIVATE_KEY_PATH=   # 商户私钥路径，如 secrets/apiclient_key.pem
WX_PAY_NOTIFY_URL=         # 支付回调地址（公网 HTTPS），如 https://api.example.com/api/v1/orders/pay/callback；空时仅 DEBUG=true 可走 mock，生产直接拒绝
WX_PAY_PUBLIC_KEY_PATH=    # 微信支付公钥 pub_key.pem 路径（新商户公钥模式回调验签），如 secrets/wx_pay_public_key.pem
WX_PAY_PUBLIC_KEY_ID=      # 微信支付公钥ID（PUB_KEY_ID_...，可选）

# 合规网关
GOV_REPORT_URL=
GOV_APP_SECRET=

# 放心签高级证书协议/智能双录/处方 PDF 签署（docs/fangxinqian_ca_integration.md）
# 先保持 false；AppKey/AppSecret、回调域名和生产联调完成后再开启。
FXQ_CA_ENABLED=false
FXQ_DOCUMENT_SIGN_ENABLED=false
FXQ_CA_REQUIRED=false
FXQ_APP_KEY=
FXQ_APP_SECRET=
FXQ_CA_REDIRECT_URL=        # 如 https://api.example.com/api/v1/ca/callback，必须 HTTPS
FXQ_COMPANY_NAME=天津逑贝互联网医院有限公司
FXQ_COMPANY_IDNO=           # 统一社会信用代码；必须与放心签企业证书主体一致
FXQ_SIGNED_PDF_DIR=         # 空时 backend/storage/prescriptions；生产应挂载持久卷并备份
FXQ_ARCHIVE_KEY=            # 签后 PDF 加密备份专用密钥；用 Fernet.generate_key() 生成并异地保管
FXQ_SERVICE_EXPIRES_ON=2027-07-23       # 当前合同签署/签章生成等套餐最早到期日
FXQ_PERSONAL_CERT_EXPIRES_ON=2031-03-07 # 当前 10 人个人数字证书最早到期日
FXQ_EXPIRY_WARNING_DAYS=30

# 天津监管平台（docs/tianjin_supervision_plan.md；密钥见平台"秘钥生成及管理"页，勿入 git）
TJ_REPORT_ENABLED=false    # true=真实上报；false 在生产保留 pending、仅 DEBUG=true 时模拟成功
TJ_GATEWAY_URL=            # 测试: https://imssp.wsjk.tj.gov.cn/net-diag-service/test-openapi/api（正式去掉 test-）
TJ_APP_KEY=
TJ_APP_SECRET=             # 32 位 hex（同时是 SM4 密钥）
TJ_UNIT_ID=                # 监管平台机构ID
ORGAN_ID=                  # 统一社会信用代码/组织机构代码
ORGAN_NAME=天津逑贝互联网医院
