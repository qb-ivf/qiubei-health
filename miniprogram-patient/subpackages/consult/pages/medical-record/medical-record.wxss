.mr { min-height: 100vh; background: #f4f5f7; padding: 24rpx; box-sizing: border-box; }
.mr-head { background: linear-gradient(135deg, #0056c4, #3979d8); border-radius: 20rpx; padding: 32rpx; color: #fff; }
.mr-head__title { display: block; font-size: 36rpx; font-weight: 700; }
.mr-head__tag { display: inline-block; margin-top: 18rpx; padding: 6rpx 18rpx; border-radius: 999rpx; background: rgba(255,255,255,.18); font-size: 24rpx; }
.mr-head__meta { display: block; margin-top: 18rpx; color: rgba(255,255,255,.8); font-size: 24rpx; }
.mr-card { margin-top: 24rpx; background: #fff; border-radius: 20rpx; padding: 8rpx 28rpx; }
.mr-row { padding: 24rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.mr-row:last-child { border-bottom: none; }
.mr-label { display: block; color: #909399; font-size: 24rpx; margin-bottom: 10rpx; }
.mr-value { display: block; color: #303133; font-size: 28rpx; line-height: 1.65; white-space: pre-wrap; }
.mr-value--strong { font-size: 32rpx; font-weight: 600; }
.mr-rx { margin-top: 24rpx; background: #fff; border-radius: 16rpx; padding: 28rpx; display: flex; justify-content: space-between; color: #0056c4; font-size: 28rpx; }
.mr-tip { margin-top: 24rpx; color: #606266; background: #eef4ff; border-radius: 16rpx; padding: 24rpx; font-size: 25rpx; line-height: 1.6; }
